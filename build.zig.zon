.{
    .name = .csar,
    .version = "0.2.0",
    .fingerprint = 0x9c8d1b0e21364c6e,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "changelog.md",
        "src",
