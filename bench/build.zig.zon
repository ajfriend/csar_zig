.{
    .name = .csar_bench,
    .version = "0.0.0",
    .fingerprint = 0x2ae0e728fa1b3da7,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // The live working tree — a path dependency, so `just ab` measures
        // uncommitted changes, not just commits.
        .csar_cur = .{ .path = ".." },
        // The baseline, pinned by hash. Bump at each release.
        //
        // A second slot pinning the SAME commit must reach it through a URL
        // that hashes differently (a commit-SHA archive rather than this tag
        // archive): zig dedupes identical pins into one module, which would
        // make a layout-faithful A/A measure one copy against itself.
        //
        // Lazy so `zig build check` compiles the current-tree side without a
        // network fetch — `just ci` must not depend on reaching GitHub.
        .csar_base = .{
            .url = "https://github.com/ajfriend/csar_zig/archive/refs/tags/v0.2.0.tar.gz",
            .hash = "csar-0.2.0-bkw2IXevBwC60WK8mkK8v1yFaOJ0bKVhr9l7xZrgzqf5",
            .lazy = true,
        },
    },
    .paths = .{ "build.zig", "build.zig.zon", "ab.zig" },
}
